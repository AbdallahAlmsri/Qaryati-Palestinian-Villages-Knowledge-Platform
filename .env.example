# Note for my teammates: Copy this file to .env and adjust the values. Never commit .env.
DB_NAME=qaryati
DB_USERNAME=qaryati_user
DB_PASSWORD=change_me_locally
DB_PORT=5544

# At least 64 characters. Generate a real one with:  openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=replace-me-with-a-long-random-value-replace-me-with-a-long-random-value-0000

# Comma-separated browser origins allowed to call the API
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000